# Copy to .env and adjust. Load it with: npm run start:env
# Nothing secret is required: this server never signs transactions and stores no keys.

# JSON-RPC endpoint. Leave empty to use Solana devnet (https://api.devnet.solana.com).
# To use mainnet, set e.g. https://api.mainnet-beta.solana.com or your provider's URL.
# If your provider puts an API key in the URL, keep this file out of version control.
SOLANA_RPC_URL=

# Commitment level for reads: processed | confirmed | finalized (default: confirmed)
SOLANA_COMMITMENT=

# Per-request RPC timeout in milliseconds, 1000-120000 (default: 30000)
SOLANA_REQUEST_TIMEOUT_MS=
