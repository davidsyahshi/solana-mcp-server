{
  "name": "solana-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server that gives AI agents safe, read-only access to Solana \u2014 balances, token accounts, transactions and simulations.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "solana-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "solana",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solana/web3.js": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
